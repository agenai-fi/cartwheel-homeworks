# macOS
.DS_Store

# Secrets. Never commit keys.
.env

# Generated world data. Recreate with: uv run python -m seed.generate
data/cartwheel.db

# Local conversation state and scenario/replay run outputs.
# SQLite keeps recent writes in the -wal file: ignoring only .sessions.db would
# leave raw conversation transcripts to be committed by `git add -A`.
.sessions.db
.sessions.db-wal
.sessions.db-shm
scenarios/results/
replay/results/
.harbor/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
scenarios/demo_pilot_gt.json
